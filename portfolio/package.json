{
  "name": "portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss}\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.2.21",
    "@angular/compiler": "^21.2.21",
    "@angular/core": "^21.2.21",
    "@angular/platform-browser": "^21.2.21",
    "@angular/platform-server": "^21.2.21",
    "@angular/router": "^21.2.21",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.21",
    "@angular/ssr": "^21.2.21",
    "@types/node": "^20.17.19",
    "jsdom": "^27.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-angular": "^0.3.2",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
